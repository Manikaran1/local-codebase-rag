CODEBASE_RAG_DATA_DIR=.codebase-rag
CODEBASE_RAG_LOG_LEVEL=INFO
CODEBASE_RAG_MAX_CHUNK_CHARS=4000

# Planned local generation configuration
CODEBASE_RAG_LLM_PROVIDER=ollama
CODEBASE_RAG_OLLAMA_BASE_URL=http://localhost:11434
CODEBASE_RAG_LLM_MODEL=

# Local indexing configuration
CODEBASE_RAG_EMBEDDING_PROVIDER=sentence-transformers
CODEBASE_RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# The default model uses a pinned commit. Custom Hub models require a 40-character commit SHA;
# local model directories require an explicit stable version or content fingerprint.
# CODEBASE_RAG_EMBEDDING_REVISION=
CODEBASE_RAG_EMBEDDING_ALLOW_DOWNLOAD=false
CODEBASE_RAG_EMBEDDING_BATCH_SIZE=32
CODEBASE_RAG_VECTOR_BACKEND=sqlite
CODEBASE_RAG_BM25_K1=1.5
CODEBASE_RAG_BM25_B=0.75

# Set ALLOW_DOWNLOAD=true only when you explicitly want to acquire model artifacts.
# Repository chunks remain local; the default only loads a local path or cached model.
